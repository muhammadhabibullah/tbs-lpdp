# Copy to .env.local and fill in. These values are PUBLIC by design (C-1):
# never put the secret / service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase dashboard → Project Settings → API Keys.
# New projects show a "publishable" key; older ones show a legacy "anon" key.
# Set whichever one your project has — the publishable key wins if both are set.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# VITE_SUPABASE_ANON_KEY=<legacy anon JWT>

# Public Cloudflare Turnstile site key. Put the matching SECRET only in
# Supabase Dashboard → Authentication → Bot and Abuse Protection.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_public_site_key

# Dev only: run the whole exam flow against an in-browser mock backed by
# questions/bank/ — no Supabase project needed. Never set this for production.
VITE_USE_MOCK=false

# Offline app flavor (v6). Do NOT set this here — it belongs in `.env.app`,
# which only `vite --mode app` reads, and that is what `npm run dev:app`,
# `npm run build:app`, and the Tauri CLI use. The Pages deploy asserts it is
# unset so the local engine and its answer keys stay out of the web bundle
# (C-29), and the app build hard-nulls the Supabase and Turnstile keys (C-31).
# VITE_OFFLINE=false

# Dev only: access local pages backed by Supabase while its maintenance window
# is active. The code also requires import.meta.env.DEV, so production builds
# ignore this value even if it is accidentally configured.
VITE_BYPASS_MAINTENANCE=false
