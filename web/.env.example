# Copy to .env.local and fill in. These values are PUBLIC by design (C-1):
# never put the secret / service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase dashboard → Project Settings → API Keys.
# New projects show a "publishable" key; older ones show a legacy "anon" key.
# Set whichever one your project has — the publishable key wins if both are set.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# VITE_SUPABASE_ANON_KEY=<legacy anon JWT>

# Dev only: run the whole exam flow against an in-browser mock backed by
# questions/bank/ — no Supabase project needed. Never set this for production.
VITE_USE_MOCK=false

# Dev only: access local pages backed by Supabase while its maintenance window
# is active. The code also requires import.meta.env.DEV, so production builds
# ignore this value even if it is accidentally configured.
VITE_BYPASS_MAINTENANCE=false
