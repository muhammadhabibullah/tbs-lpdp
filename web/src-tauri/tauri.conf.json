{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TBS LPDP Try Out",
  "version": "0.1.0",
  "identifier": "io.github.muhammadhabibullah.tbslpdp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:app",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TBS LPDP Try Out",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": { "enable": false },
      "capabilities": ["default", "desktop"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://muhammadhabibullah.github.io https://api.github.com; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb", "rpm"],
    "publisher": "Muhammad Habibullah",
    "copyright": "© 2026 Muhammad Habibullah — MIT",
    "category": "Education",
    "homepage": "https://github.com/muhammadhabibullah/tbs-lpdp",
    "license": "MIT",
    "shortDescription": "Try out Tes Bakat Skolastik LPDP, gratis dan sepenuhnya offline.",
    "longDescription": "Simulasi Tes Bakat Skolastik (TBS) LPDP dengan format dan tampilan menyerupai aplikasi CBT resmi: tiga mata uji berurutan, 60 soal dalam 90 menit, penilaian dan pembahasan lengkap. Seluruh bank soal tersimpan di dalam aplikasi sehingga try out dapat dikerjakan tanpa koneksi internet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Indonesian"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/muhammadhabibullah/tbs-lpdp/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwOEIyOTU3QUFEOEExMzcKUldRM29kaXFWeW1Mc0pvam1reHdpanE0Y0NOSXVuRFJUMFFvbWxqNm1sTHdlN3BVaGI0MzlHNmQK"
    }
  }
}
